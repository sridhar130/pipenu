# -*- mode:tcl -*- 
#------------------------------------------------------------------------------
# RPC on hydrogen ... start from pi- stops in CH2
# a copy of the input file saved in /exp/mu2e/data/projects/pipenu/datasets/bpim0b0s2dr0000
#------------------------------------------------------------------------------
BEGIN_PROLOG
  PROCESS_CODE   : "mu2eMuonCaptureAtRest"
END_PROLOG

#include "Production/JobConfig/primary/TargetStopParticle.fcl"

services.SeedService.baseSeed: 8
#------------------------------------------------------------------------------
# geometry and the magnetic field
#------------------------------------------------------------------------------
services.GeometryService.inputFile  : "pipenu/common/geom_baseline.txt"
services.GeometryService.bFieldFile : "Offline/Mu2eG4/geom/bfgeom_v01.txt"

physics.producers.generate : { @table::EventGeneratorMu
    simpCollTag    : "TargetStopResampler"
    verbosityLevel : 0
    stopPdgCode    : 13                               ## stopped mu-
    lifetime       : 864   ## 26. ## 2196.98          ## muon lifetime, ns
    makeHistograms : 1
#------------------------------------------------------------------------------
# use particle gun to generate 130 MeV photons
# as the radius of the converter is 25 cm and the radius of the degrader is 15cm,
# [-0.1,0.1] simply increases the efficiency by a factor of 10
#------------------------------------------------------------------------------
    generator  : { tool_type: "StoppedPiENuGenerator" 
        processCode            : @local::PROCESS_CODE
        czmin                  : -1.0
        czmax                  : 1.0
        spectrum: {
            spectrumShape      : "tabulated"
            spectrumFileName   : "Offline/ConditionsService/data/neutronSpectrum.txt"
            spectrumVariable   : "kineticEnergy"            ## "kineticEnergy" / "momentum" / "totalEnergy"
            pdgCode            : 2112                       ## neutron
            # elow               : 0.
            # ehi                : 130
            BinCenter          : true
            spectrumResolution : 0.5                        ## MeV  ... bin width ?
        }
    }
}

physics.producers.g4run.inputs  : {
    primaryType                 : StageParticles
    primaryTag                  : "generate"
    inputMCTrajectories         : ""
    inputPhysVolumeMultiInfo    : "TargetStopResampler"   ## "compressPVTargetStops" / "TargetStopResampler"
    simStageOverride            : 2                       ## 3, if extra tracing step
    updateEventLevelVolumeInfos : {
 	input                   : "TargetStopResampler:eventlevel" ## "compressPVTargetStops:eventlevel"
 	outInstance             : "eventlevel"
    }
}

physics.filters.PrimaryFilter : { module_type : DetectorStepFilter  ## is it doing an OR ? 
    ORRequirements        : true                        ## either one is OK
    StrawGasSteps         : [ "StrawGasStepMaker"   ]
    CaloShowerSteps       : [ "CaloShowerStepMaker" ]
    CrvSteps              : [ ] # dont filter on CRV since that can't trigger
    MinimumTrkStepEnergy  : -1.       ## set it low  ;1.0e-6 # 1 ev
    MinimumCaloStepEnergy : -1.
    MinimumCrvStepEnergy  : 0.1
    MinimumCrvSteps       : 1
    MinimumPartMom        : -1    ## 50.0    #         # MeV/c
    MaximumPartMom        : 1.0e6 ##         # MeV/c
    KeepPDG               : [ ]   ##         # Loop at steps from all particle types
    MinimumTrkSteps       : 1     ## 12      # primary must produce at least this many TrkSteps
    MinimumSumCaloStepE   : -1    ## 45.0    # or at least this much calo energy
}


physics.producers.FindMCPrimary.PrimaryProcess  : @local::PROCESS_CODE
# physics.producers.FindMCPrimary.debugLevel      : 100

physics.filters.TargetStopResampler.mu2e.MaxEventsToSkip : 0

#------------------------------------------------------------------------------
# 2024-09-07: to use xrootd do 'mu2einit; vomsCert'
# back to mu^- stops in the ST
#------------------------------------------------------------------------------
physics.filters.TargetStopResampler.fileNames            :
[
# "root://fndca1.fnal.gov/pnfs/fnal.gov/usr/mu2e/scratch/users/murat/datasets/pipenu/bpim0b0s24r0000/sim.murat.bpim0b0s24r0000.pipenu.001210_00000000.art"
# "/pnfs/mu2e/scratch/users/murat/datasets/pipenu/bpim0b0s24r0000/sim.murat.bpim0b0s24r0000.pipenu.001210_00000000.art"
  "/pnfs/mu2e/persistent/datasets/phy-sim/sim/mu2e/MuminusStopsCat/MDC2020p/art/6d/cf/sim.mu2e.MuminusStopsCat.MDC2020p.001201_00000000.art"
]
physics.filters.TargetStopResampler.mu2e.products.genParticleMixer.mixingMap : [[ "beamResampler"   , "" ]] ## "generate"
physics.filters.TargetStopResampler.mu2e.products.simParticleMixer.mixingMap : [[ "TargetStopFilter", "" ]]
physics.filters.TargetStopResampler.mu2e.products.stepPointMCMixer.mixingMap : [[ "TargetStopFilter:virtualdetector", ":" ]]
physics.filters.TargetStopResampler.mu2e.products.volumeInfoMixer.srInput    : "compressPVTargetStops"

physics.PrimaryPath   : [ TargetStopResampler, @sequence::Common.generateSequence,
                          GenFilter,
                          @sequence::Common.g4Sequence,
                          # @sequence::Primary.PrimarySequence
                            @sequence::Primary.DetStepSequence,
                            PrimaryFilter,                      ## require at least something .... just dont filter
                          # @sequence::Primary.FinalizeSequence
                            compressDetStepMCs
                            # , FindMCPrimary
                         ]

physics.trigger_paths : [ PrimaryPath ]

outputs.PrimaryOutput.fileName: "dts.user.neut0b0s34r0000.pipenu.001210_00000000.art"
services.TFileService.fileName: "hst.user.neut0b0s34r0000.pipenu.001210_00000000.root"  ## /dev/null"

source.firstRun   : 1210
source.firstSubRun:    0

# don't use simple physics list - smth wrong with QGSP_BERT
physics.producers.g4run.physics.physicsListName:ShieldingM_EMZ  ## "QGSP_BERT"
#------------------------------------------------------------------------------
# Enable these commands not to have the printout for each event in the log file
#------------------------------------------------------------------------------
services.message.destinations.log.categories.ArtReport.reportEvery : 50
services.message.destinations.log.categories.ArtReport.limit       : 5
services.message.destinations.log.categories.ArtReport.timespan    : 1000
