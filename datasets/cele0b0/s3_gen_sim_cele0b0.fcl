# -*- mode:tcl -*- 
#------------------------------------------------------------------------------
#
#------------------------------------------------------------------------------
BEGIN_PROLOG
  PROCESS_CODE : "mu2eCeMinusEndpoint"
END_PROLOG

#include "Production/JobConfig/primary/TargetStopParticle.fcl"

services.SeedService.baseSeed: 8
#------------------------------------------------------------------------------
# geometry and the magnetic field
#------------------------------------------------------------------------------
services.GeometryService.inputFile  : "pipenu/datasets/cele0b0/geom_pipenu_cele0b0.txt"
services.GeometryService.bFieldFile : "Offline/Mu2eG4/geom/bfgeom_v01.txt"
#------------------------------------------------------------------------------
# Enable these commands not to have the printout for each event in the log file
#------------------------------------------------------------------------------
services.message.destinations.log.categories.ArtReport.reportEvery : 50
services.message.destinations.log.categories.ArtReport.limit       : 5
services.message.destinations.log.categories.ArtReport.timespan    : 1000
#------------------------------------------------------------------------------
# source
#------------------------------------------------------------------------------
source: { module_type : EmptyEvent }

physics.producers.generate : { @table::EventGeneratorMu 
    simpCollTag    : "TargetStopResampler"
    verbosityLevel : 0
    stopPdgCode    : 13                        ## stopped mu-
    lifetime       : 864.                      ## muon lifetime in Al, ns
    makeHistograms : 1
#------------------------------------------------------------------------------
# use particle gun to generate 139.570/2 MeV e+, take into account the radiative corrections
# those are a universal function
#------------------------------------------------------------------------------
    generator  : { tool_type: "StoppedPiENuGenerator" 
        processCode            : @local::PROCESS_CODE
        spectrum: {
            pdgCode            :  11                      ## e+
            spectrumShape      : "monoenergetic"
            spectrumVariable   : "totalEnergy"      ## "kineticEnergy" / "momentum" / "totalEnergy"
            ehi                : 104.973
            elow               : 0.
            spectrumResolution : 0.1                # MeV
        }
    }
}

physics.producers.g4run.inputs  : {
    primaryType                 : StageParticles
    primaryTag                  : "generate"
    inputMCTrajectories         : ""
    inputPhysVolumeMultiInfo    : "TargetStopResampler"   ## "compressPVTargetStops" / "TargetStopResampler"
    simStageOverride            : 2                       ## 3, if extra tracing step
    updateEventLevelVolumeInfos : {
 	input                   : "TargetStopResampler:eventlevel" ## "compressPVTargetStops:eventlevel"
 	outInstance             : "eventlevel"
    }
}

physics.producers.FindMCPrimary.PrimaryProcess  : @local::PROCESS_CODE
# physics.producers.FindMCPrimary.debugLevel    : 100

physics.filters.TargetStopResampler.mu2e.products.genParticleMixer.mixingMap : [[ "beamResampler", "" ]] ## "generate"
physics.filters.TargetStopResampler.mu2e.MaxEventsToSkip : 0

physics.filters.TargetStopResampler.fileNames            : [
  "/pnfs/mu2e/persistent/datasets/phy-sim/sim/mu2e/MuminusStopsCat/MDC2020p/art/6d/cf/sim.mu2e.MuminusStopsCat.MDC2020p.001201_00000000.art"
]

physics.filters.PrimaryFilter.MinimumPartMom      : 40
physics.filters.PrimaryFilter.MinimumSumCaloStepE : 25

# don't use simple physics list - smth wrong with QGSP_BERT
physics.producers.g4run.physics.physicsListName:ShieldingM_EMZ  ## "QGSP_BERT"
physics.producers.g4run.physics.minRangeRegionCuts: { CalorimeterMother : 0.1}
physics.producers.g4run.TrajectoryControl: @local::mu2eg4DefaultTrajectories

physics.producers.g4run.SDConfig.enableSD: [@sequence::physics.producers.g4run.SDConfig.enableSD,
                                            stoppingtarget ,
                                            protonabsorber ]
#------------------------------------------------------------------------------
# output
#------------------------------------------------------------------------------
outputs               : {
    PrimaryOutput : {  @table::Primary.PrimaryOutput }
}

outputs.PrimaryOutput.fileName: "dts.user.cele0b0s31r0000.pipenu.001210_00000000.art"
services.TFileService.fileName: "nts.user.cele0b0s31r0000.pipenu.001210_00000000.root"

source.firstRun   : 1210
source.firstSubRun:    0
